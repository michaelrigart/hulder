# One scenario per field the pull request check reads besides the files and the head.
pr_view_refused() {
  local field="$1" value="$2" problem="$3"
  new_scenario "view-$field" --fast
  git -C "$clone" checkout --quiet -B main
  git -C "$clone" push --quiet --force origin HEAD:main
  snapshot="$(git -C "$clone" rev-parse HEAD)"
  printf '%s\n' "$value" >"$STUB_DIR/pr-view-$field"
  run_release
  expect "f4: $field $value fails" test "$status" -ne 0
  expect "f4: $field $value says the pull request is not the release commit alone" contains "$output" "pull request #1 is not the release commit alone"
  expect "f4: $field $value is named" contains "$output" "$problem"
  expect "f4: $field $value merges nothing" lacks "$(cat "$STUB_DIR/calls.log")" "pr merge"
  expect "f4: $field $value leaves main unchanged" test "$(git --git-dir="$bare" rev-parse refs/heads/main)" == "$snapshot"
}
pr_view_refused state CLOSED "it is CLOSED, not OPEN"
pr_view_refused base develop "its base is develop, not main"
pr_view_refused cross true "it comes from another repository"


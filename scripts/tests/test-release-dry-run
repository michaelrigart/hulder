# new_scenario <name> [--fast]: --fast swaps scripts/verify-app for a stub that accepts anything,
# for scenarios that run with $fast_build instead of a real build.
new_scenario() {
  dir="$work/$1"
  bare="$dir/origin.git"
  clone="$dir/clone"
  export STUB_DIR="$dir/stub"
  export STUB_BARE="$bare"
  mkdir -p "$STUB_DIR/prs"
  echo 1 >"$STUB_DIR/next-pr"
  : >"$STUB_DIR/calls.log"
  : >"$dir/pushes.log"

  git clone --quiet --bare "$root" "$bare"
  git --git-dir="$bare" for-each-ref --format='%(refname)' refs/tags 'refs/heads/release/*' |
    while IFS= read -r ref; do git --git-dir="$bare" update-ref -d "$ref"; done
  git --git-dir="$bare" config core.hooksPath "$bare/hooks"
  mkdir -p "$bare/hooks"
  accept_pushes
  git clone --quiet -c core.hooksPath=/dev/null "$bare" "$clone"
  assert_no_tags
  git -C "$clone" config user.name "Release Test"
  git -C "$clone" config user.email "release-test@example.invalid"
  git -C "$clone" config commit.gpgsign false
  git -C "$clone" config tag.gpgsign false
  assert_local_origin

  git -C "$root" ls-files -z -co --exclude-standard |
    while IFS= read -r -d '' file; do
      if [[ -e "$root/$file" ]]; then printf '%s\0' "$file"; fi
    done |
    tar -C "$root" --null -T - -cf - |
    tar -C "$clone" -xf -
  fixture_changelog >"$clone/CHANGELOG.md"
  if [[ "${2:-}" == --fast ]]; then
    printf '#!/bin/sh\nexit 0\n' >"$clone/scripts/verify-app"
  fi
  git -C "$clone" add -A
  git -C "$clone" commit --quiet --allow-empty -m "Snapshot for the test"

  tap_remote
  export MISE_TRUSTED_CONFIG_PATHS="$clone"
}

# Logs every push to $dir/pushes.log and accepts it.
accept_pushes() {
  printf '#!/bin/sh\ncat >>"%s/pushes.log"\n' "$dir" >"$bare/hooks/pre-receive"
  chmod +x "$bare/hooks/pre-receive"
}

fixture_changelog() {
  cat <<EOF
# Changelog

Fixture preamble.

## [Unreleased]

### Added

- $fixture_entry

## [$fixture_earlier] - 2025-01-01

### Added

- Fixture change from an earlier release.

[Unreleased]: https://github.com/$repo/compare/$fixture_earlier...HEAD
[$fixture_earlier]: https://github.com/$repo/releases/tag/$fixture_earlier
EOF
}

assert_no_tags() {
  if [[ -n "$(git --git-dir="$bare" tag)" || -n "$(git -C "$clone" tag)" ]]; then
    echo "ABORT: $dir inherited tags from $root" >&2
    exit 3
  fi
}

assert_local_origin() {
  local url
  url="$(git -C "$clone" remote get-url origin)"
  if [[ "$url" != "$bare" || "$bare" != /* ]]; then
    echo "ABORT: origin of $clone is '$url', not the local bare repository $bare" >&2
    exit 3
  fi
}

tap_remote() {
  local seed="$dir/tap-seed"
  git init --quiet --bare --initial-branch=main "$STUB_DIR/tap.git"
  git --git-dir="$STUB_DIR/tap.git" config core.hooksPath /dev/null
  git init --quiet --initial-branch=main "$seed"
  git -C "$seed" config user.name "Release Test"
  git -C "$seed" config user.email "release-test@example.invalid"
  git -C "$seed" config commit.gpgsign false
  git -C "$seed" config core.hooksPath /dev/null
  echo tap >"$seed/README.md"
  git -C "$seed" add README.md
  git -C "$seed" commit --quiet -m "Start the tap"
  git -C "$seed" push --quiet "$STUB_DIR/tap.git" main
}

on_main_with_section() {
  assert_local_origin
  git -C "$clone" checkout --quiet -B main
  (cd "$clone" && scripts/changelog.py release "$1" --repo "$repo")
  git -C "$clone" commit --quiet -am "Release $1"
  git -C "$clone" push --quiet --force origin HEAD:main
}

run_release() {
  assert_local_origin
  : >"$dir/pushes.log"
  status=0
  output="$(cd "$clone" && scripts/release "$@" 2>&1)" || status=$?
}

refs() { git --git-dir="$bare" for-each-ref --format='%(refname) %(objectname)'; }
gh_writes() { grep -Ev '^(auth status|api repos/|pr list|pr view|release view|release download|repo clone)' "$STUB_DIR/calls.log" || true; }
pr_field() { sed -n "s/^$2=//p" "$STUB_DIR/prs/$1" | head -1; }
# True when origin's main is a merge commit whose second parent is $1.
origin_merged() {
  local commit first second extra
  read -r commit first second extra < <(git --git-dir="$bare" rev-list --parents -n 1 refs/heads/main)
  [[ -n "$second" && -z "$extra" && "$second" == "$1" ]]
}
tap_cask() { git --git-dir="$STUB_DIR/tap.git" show main:Casks/hulder.rb; }
seed_cask() {
  local edit="$dir/tap-edit"
  rm -rf "$edit"
  git clone --quiet -c core.hooksPath=/dev/null "$STUB_DIR/tap.git" "$edit"
  git -C "$edit" config user.name "Release Test"
  git -C "$edit" config user.email "release-test@example.invalid"
  mkdir -p "$edit/Casks"
  printf 'cask "hulder" do\n  version "%s"\n  sha256 "%s"\nend\n' "$1" "$2" >"$edit/Casks/hulder.rb"
  git -C "$edit" add Casks/hulder.rb
  git -C "$edit" commit --quiet -m "hulder $1"
  git -C "$edit" push --quiet origin HEAD:main
}
sha_of() { shasum -a 256 "$1" | cut -d' ' -f1; }
# seed_pr <n> <branch> <state> <cross>: a stub pull request from <branch> into main.
seed_pr() {
  printf 'head=%s\nbase=main\nstate=%s\ncross=%s\n' "$2" "$3" "$4" >"$STUB_DIR/prs/$1"
  if [[ "$(cat "$STUB_DIR/next-pr")" -le "$1" ]]; then echo $(($1 + 1)) >"$STUB_DIR/next-pr"; fi
}
# release_on_branch <v>: main level with origin, then release/<v> with a 'Release <v>' commit that
# only changelog.py wrote; leaves head_before, release_commit and refs_before for the case.
release_on_branch() {
  git -C "$clone" checkout --quiet -B main
  git -C "$clone" push --quiet --force origin HEAD:main
  head_before="$(git -C "$clone" rev-parse HEAD)"
  refs_before="$(refs)"
  git -C "$clone" switch --quiet -c "release/$1"
  (cd "$clone" && scripts/changelog.py release "$1" --repo "$repo")
  git -C "$clone" commit --quiet -am "Release $1"
  release_commit="$(git -C "$clone" rev-parse HEAD)"
}
# later_on_origin <add|move>: a commit on origin's main, made on the bare repository directly.
# add puts a new entry under Unreleased; move takes it from the version's section back to Unreleased.
later_entry="Later entry merged after the cut."
cat >"$work/later-entry" <<'LATER'
#!/usr/bin/env bash
set -euo pipefail
export GIT_DIR="$1"
mode="$2" fixture="$3" entry="$4"
export GIT_INDEX_FILE="$(mktemp -u "${TMPDIR:-/tmp}/later-index.XXXXXX")"
export GIT_AUTHOR_NAME=Later GIT_AUTHOR_EMAIL=later@example.invalid
export GIT_COMMITTER_NAME=Later GIT_COMMITTER_EMAIL=later@example.invalid
tip="$(git rev-parse refs/heads/main)"
git read-tree "$tip"
if [[ "$mode" == add ]]; then
  edit='{ print } $0 == "- " fixture { print "- " entry }'
else
  edit='$0 == "- " entry { next } { print } $0 == "## [Unreleased]" { print ""; print "### Added"; print ""; print "- " entry }'
fi
blob="$(git show "$tip:CHANGELOG.md" | awk -v fixture="$fixture" -v entry="$entry" "$edit" | git hash-object -w --stdin)"
git update-index --cacheinfo "100644,$blob,CHANGELOG.md"
commit="$(git commit-tree "$(git write-tree)" -p "$tip" -m "Later work: $mode")"
git update-ref refs/heads/main "$commit" "$tip"
rm -f "$GIT_INDEX_FILE"
LATER
chmod +x "$work/later-entry"
later_on_origin() { "$work/later-entry" "$bare" "$1" "$fixture_entry" "$later_entry"; }
# expect_landed <name> <R>: the run exited 0 and landed R through pull request 1, then tagged R
# and updated the cask; it never pushed main.
expect_landed() {
  local name="$1" r="$2"
  if [[ "$status" -ne 0 ]]; then echo "$output" >&2; fi
  expect "$name: exits 0" test "$status" -eq 0
  expect "$name: origin's main merges the release commit" origin_merged "$r"
  expect "$name: pull request 1 is merged" test "$(pr_field 1 state)" == MERGED
  expect "$name: there is only one pull request" test "$(ls "$STUB_DIR/prs" | wc -l | tr -d ' ')" -eq 1
  expect "$name: the tag is on the release commit" test "$(git --git-dir="$bare" rev-parse "refs/tags/$v^{commit}")" == "$r"
  expect "$name: the cask has the version" contains "$(tap_cask)" "version \"$v\""
  expect "$name: never pushes main" lacks "$(cat "$dir/pushes.log")" "refs/heads/main"
}

echo "== a: --dry-run builds, verifies and packages, and writes nothing else"
new_scenario dry
git -C "$clone" checkout --quiet -b rehearsal
tags_before="$(git -C "$clone" tag)"
log_before="$(git -C "$clone" log --all --format=%H)"
refs_before="$(refs)"
changelog_before="$(sha_of "$clone/CHANGELOG.md")"

run_release --dry-run
expect "a: exits 0 from a branch other than main" test "$status" -eq 0
if [[ "$status" -ne 0 ]]; then echo "$output" >&2; fi

version="$(sed -n 's/^Version: //p' <<<"$output" | head -1)"
expect "a: prints a YYYYMMDD-HHMM version" test -n "$version" -a "${#version}" -eq 13
built_apps="$(find "$clone/build" -type d -name Hulder.app -prune 2>/dev/null || true)"

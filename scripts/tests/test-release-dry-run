#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 0 ]]; then
  echo "usage: $0" >&2
  exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
team=CX4MWR5579
repo=michaelrigart/hulder

export GIT_CONFIG_COUNT=2
export GIT_CONFIG_KEY_0=commit.gpgsign GIT_CONFIG_VALUE_0=false
export GIT_CONFIG_KEY_1=tag.gpgsign GIT_CONFIG_VALUE_1=false

work="$(mktemp -d "${TMPDIR:-/tmp}/hulder-release-test.XXXXXX")"
trap 'rm -rf "$work"' EXIT

failures=0
cases=0

fixture_entry="Fixture change waiting for a release."
fixture_earlier=20250101-0900

pass() {
  cases=$((cases + 1))
  echo "ok   $1"
}

fail() {
  cases=$((cases + 1))
  failures=$((failures + 1))
  echo "FAIL $1" >&2
}

expect() {
  local name="$1"
  shift
  if "$@"; then pass "$name"; else fail "$name"; fi
}

contains() { [[ "$1" == *"$2"* ]]; }
lacks() { [[ "$1" != *"$2"* ]]; }
rejects() { ! "$@"; }

# Spotlight skips folders whose names end in .noindex, so a build inside one never
# shows up next to the installed app in Spotlight or Alfred.
all_inside_noindex() {
  local path
  [[ -n "$1" ]] || return 1
  while IFS= read -r path; do
    [[ "${path#"$clone"/}" == */*.noindex/* ]] || return 1
  done <<<"$1"
}

bin="$work/bin"
mkdir -p "$bin"
cat >"$bin/gh" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
echo "$*" >>"$STUB_DIR/calls.log"
bare_git() { git --git-dir="$STUB_BARE" "$@"; }
pr_get() { sed -n "s/^$2=//p" "$1" | head -1; }
pr_put() {
  { grep -v "^$2=" "$1" || true; printf '%s=%s\n' "$2" "$3"; } >"$STUB_DIR/pr.tmp"
  mv "$STUB_DIR/pr.tmp" "$1"
}
case "$1 ${2:-}" in
  "auth status")
    if [[ -e "$STUB_DIR/auth-fails" ]]; then
      echo "unknown flag: --json" >&2
      exit 1
    fi
    printf '%s|%s|%s|%s\n' \
      "$(cat "$STUB_DIR/gh-state" 2>/dev/null || echo success)" \
      "$(cat "$STUB_DIR/gh-login" 2>/dev/null || echo release-test)" \
      "$(cat "$STUB_DIR/token-source" 2>/dev/null || echo keyring)" \
      "$(cat "$STUB_DIR/scopes" 2>/dev/null || echo 'gist, read:org, repo')"
    ;;
  "api repos/"*)
    if [[ -e "$STUB_DIR/api-fails" ]]; then
      echo "gh stub: HTTP 502" >&2
      exit 1
    fi
    if [[ -e "$STUB_DIR/not-admin" ]]; then echo false; else echo true; fi
    ;;
  "pr list")
    head="" base="" want=open
    shift 2
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --head) head="$2"; shift 2 ;;
        --base) base="$2"; shift 2 ;;
        --state) want="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    case "$want" in
      open | all) ;;
      *)
        echo "gh stub: pr list --state $want is not supported" >&2
        exit 99
        ;;
    esac
    for file in "$STUB_DIR"/prs/*; do
      [[ -f "$file" ]] || continue
      if [[ "$want" == open && "$(pr_get "$file" state)" != OPEN ]]; then continue; fi
      if [[ "$(pr_get "$file" head)" == "$head" && "$(pr_get "$file" base)" == "$base" ]]; then
        printf '%s|%s|%s\n' "$(basename "$file")" "$(pr_get "$file" state)" "$(pr_get "$file" cross)"
      fi
    done
    ;;
  "pr view")
    file="$STUB_DIR/prs/$3"
    if [[ ! -f "$file" ]]; then
      echo "gh stub: no pull request $3" >&2
      exit 1
    fi
    state="$(pr_get "$file" state)"
    if [[ "$state" == OPEN ]]; then
      head_oid="$(bare_git rev-parse "refs/heads/$(pr_get "$file" head)")"
    else
      head_oid="$(pr_get "$file" head_oid)"
    fi
    files=""
    if merge_base="$(bare_git merge-base refs/heads/main "$head_oid" 2>/dev/null)"; then
      files="$(bare_git diff --name-only "$merge_base" "$head_oid" | paste -sd, -)"
    fi
    if [[ -e "$STUB_DIR/pr-view-files" ]]; then files="$(cat "$STUB_DIR/pr-view-files")"; fi
    if [[ -e "$STUB_DIR/pr-view-head" ]]; then head_oid="$(cat "$STUB_DIR/pr-view-head")"; fi
    base="$(pr_get "$file" base)"
    cross="$(pr_get "$file" cross)"
    if [[ -e "$STUB_DIR/pr-view-state" ]]; then state="$(cat "$STUB_DIR/pr-view-state")"; fi
    if [[ -e "$STUB_DIR/pr-view-base" ]]; then base="$(cat "$STUB_DIR/pr-view-base")"; fi
    if [[ -e "$STUB_DIR/pr-view-cross" ]]; then cross="$(cat "$STUB_DIR/pr-view-cross")"; fi
    printf '%s|%s|%s|%s|%s\n' "$state" "$base" "$head_oid" "$cross" "$files"
    ;;
  "pr create")
    head="" base="" body="" pr_repo=""
    shift 2
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --repo) pr_repo="$2"; shift 2 ;;
        --head) head="$2"; shift 2 ;;
        --base) base="$2"; shift 2 ;;
        --body-file) body="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    if [[ -e "$STUB_DIR/pr-create-fails" ]]; then
      echo "gh stub: could not create the pull request" >&2
      exit 1
    fi
    if [[ ! -f "$body" ]]; then
      echo "gh stub: pr create without a readable --body-file" >&2
      exit 99
    fi
    if ! bare_git rev-parse -q --verify "refs/heads/$head" >/dev/null; then
      echo "gh stub: $head is not on origin" >&2
      exit 1
    fi
    for file in "$STUB_DIR"/prs/*; do
      [[ -f "$file" ]] || continue
      if [[ "$(pr_get "$file" head)" == "$head" && "$(pr_get "$file" base)" == "$base" && "$(pr_get "$file" state)" == OPEN && "$(pr_get "$file" cross)" == false ]]; then
        echo "gh stub: a pull request for $head into $base already exists" >&2
        exit 1
      fi
    done
    number="$(cat "$STUB_DIR/next-pr")"
    echo $((number + 1)) >"$STUB_DIR/next-pr"
    printf 'head=%s\nbase=%s\nstate=OPEN\ncross=false\n' "$head" "$base" >"$STUB_DIR/prs/$number"
    if [[ -e "$STUB_DIR/create-warning" ]]; then echo "Warning: 1 uncommitted change"; fi
    echo "https://github.com/$pr_repo/pull/$number"
    ;;
  "pr merge")
    number="$3"
    owner="" sha="" has_merge=0 has_admin=0
    shift 3
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --repo) owner="${2%%/*}"; shift 2 ;;
        --merge) has_merge=1; shift ;;
        --admin) has_admin=1; shift ;;
        --match-head-commit) sha="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    if [[ "$has_merge" -ne 1 || "$has_admin" -ne 1 || -z "$sha" ]]; then
      echo "gh stub: pr merge needs --merge, --admin and --match-head-commit" >&2
      exit 99
    fi
    file="$STUB_DIR/prs/$number"
    if [[ -e "$STUB_DIR/pr-merge-fails" || ! -f "$file" || "$(pr_get "$file" state)" != OPEN ]]; then
      echo "gh stub: pull request #$number is not mergeable" >&2
      exit 1
    fi
    head="$(pr_get "$file" head)"
    tip="$(bare_git rev-parse "refs/heads/$head")"
    if [[ "$tip" != "$sha" ]]; then
      echo "gh stub: the head commit changed" >&2
      exit 1
    fi
    if [[ -x "$STUB_DIR/before-merge" ]]; then "$STUB_DIR/before-merge"; fi
    main_tip="$(bare_git rev-parse refs/heads/main)"
    if ! tree="$(bare_git merge-tree --write-tree "$main_tip" "$tip")"; then
      echo "gh stub: the pull request conflicts with main" >&2
      exit 1
    fi
    tree="${tree%%$'\n'*}"
    subject="Merge pull request #$number from $owner/$head"
    export GIT_AUTHOR_NAME=GitHub GIT_AUTHOR_EMAIL=noreply@github.com
    export GIT_COMMITTER_NAME=GitHub GIT_COMMITTER_EMAIL=noreply@github.com
    merge="$(bare_git commit-tree "$tree" -p "$main_tip" -p "$tip" -m "$subject")"
    bare_git update-ref refs/heads/main "$merge" "$main_tip"
    pr_put "$file" state MERGED
    pr_put "$file" head_oid "$tip"
    ;;
  "release view")
    if [[ ! -e "$STUB_DIR/release-exists" ]]; then
      echo "release not found" >&2
      exit 1
    fi
    if [[ -e "$STUB_DIR/asset.zip" ]]; then
      printf 'Hulder-%s.zip\t%s\n' "$3" "$(cat "$STUB_DIR/asset-state" 2>/dev/null || echo uploaded)"
    fi
    ;;
  "release create")
    touch "$STUB_DIR/release-exists"
    if [[ -x "$STUB_DIR/after-release-create" ]]; then "$STUB_DIR/after-release-create"; fi
    ;;
  "release upload")
    if [[ -e "$STUB_DIR/asset.zip" ]]; then
      echo "a release asset with the same name already exists" >&2
      exit 1
    fi
    cp "$4" "$STUB_DIR/asset.zip"
    ;;
  "release delete-asset")
    [[ " $* " == *" --yes "* ]] || { echo "gh stub: delete-asset without --yes would prompt" >&2; exit 99; }
    rm -f "$STUB_DIR/asset.zip" "$STUB_DIR/asset-state"
    ;;
  "release download")
    pattern="" dir=""
    shift 3
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --pattern) pattern="$2"; shift 2 ;;
        --dir) dir="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    cp "$STUB_DIR/asset.zip" "$dir/$pattern"
    ;;
  "repo clone")
    [[ "$3" == michaelrigart/homebrew-tap ]] || { echo "unexpected clone of $3" >&2; exit 99; }
    git clone --quiet -c core.hooksPath=/dev/null "$STUB_DIR/tap.git" "$4"
    ;;
  *)
    echo "gh stub: unexpected call: $*" >&2
    exit 99
    ;;
esac
STUB
chmod +x "$bin/gh"
export PATH="$bin:$PATH"

nosec="$work/nosec"
mkdir -p "$nosec"
printf '#!/bin/sh\nexit 0\n' >"$nosec/security"
chmod +x "$nosec/security"

